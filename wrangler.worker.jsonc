// Workers deployment (workers.dev) — same D1 database and R2 bucket as the Pages site.
// Deploy: npm run deploy:worker
{
  "name": "hm-labor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // run the API next to the D1 database (ENAM) instead of next to the user:
  // pages make several queries, so this turns many long round trips into one
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hm-labor-db", "database_id": "b8438540-1e88-4102-b70a-16dd7ac7af2a", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "hm-labor-files" }],
  "observability": { "enabled": true }
}
