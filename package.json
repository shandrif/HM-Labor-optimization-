{
  "name": "hm-labor-optimization",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy dist --project-name hm-labor --branch main",
    "db:migrate": "wrangler d1 migrations apply hm-labor-db --remote",
    "hash-password": "node scripts/hash-password.mjs",
    "deploy:worker": "npm run build && wrangler deploy -c wrangler.worker.jsonc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shandrif/HM-Labor-optimization-.git"
  },
  "bugs": {
    "url": "https://github.com/shandrif/HM-Labor-optimization-/issues"
  },
  "homepage": "https://github.com/shandrif/HM-Labor-optimization-#readme",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wrangler": "^4.168.0"
  },
  "dependencies": {
    "hono": "^4.13.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "private": true,
  "type": "module"
}
